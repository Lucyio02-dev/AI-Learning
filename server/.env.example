# 后端环境变量示例。复制为 .env 或在启动环境中设置。
# 密钥只存在于服务器环境；前端通过同源 /api 代理访问，永远接触不到密钥。

# 服务端口与监听地址（第二设备同步时 HOST 设为 0.0.0.0，并自行做好网络边界）
PORT=8787
AI_LEARNING_HOST=127.0.0.1

# 数据目录（账户、任务、RAG 索引、产物）
AI_LEARNING_DATA=./server/data

# 模型代理（OpenAI 兼容协议；两个都可选，前端可切换）
DEEPSEEK_API_KEY=
GLM_API_KEY=

# 并发限制
AI_LEARNING_MAX_TASKS=1
